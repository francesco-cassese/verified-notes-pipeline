# Server Configuration
# La porta su cui il server rimarrà in ascolto
PORT=3000

# AI Configuration
CLAUDE_API_KEY=your_api_key_here

# Search API
# Chiave API per utilizzare il Brave Search Engine
BRAVE_API_KEY=your_api_key_here

# Multi-agent workflow (opzionali, con default sensati in utils/settings.js)
MODEL_NAME=claude-haiku-4-5
NOTES_DIR=data/notes
MAX_GENERATION_ATTEMPTS=3
MODEL_TIMEOUT_MS=30000
SEARCH_TIMEOUT_MS=10000
PAGE_FETCH_TIMEOUT_MS=8000

# Rate limit sull'endpoint di generazione (opzionali, con default sensati in utils/settings.js)
GENERATION_RATE_LIMIT_WINDOW_MS=900000
GENERATION_RATE_LIMIT_MAX=5